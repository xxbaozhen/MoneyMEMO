<Window
    x:Class="MoneyMEMO.Views.Start"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:MoneyMEMO.Converters"
    xmlns:ViewModels="clr-namespace:MoneyMEMO.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MoneyMEMO.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Start"
    Width="570"
    Height="370"
    ResizeMode="NoResize"
    mc:Ignorable="d">
    <Window.Resources>
        <Converters:CategoryToStringConverter x:Key="CategoryToStringConverter" />
    </Window.Resources>
    <Window.DataContext>
        <ViewModels:StartViewModel />
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Command="{Binding ExitCommand}" Header="退出" />
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Command="{Binding AddRecordCommand}" Header="添加记录" />
                <MenuItem Command="{Binding SearchRecordCommand}" Header="查找记录" />
                <MenuItem Command="{Binding DeleteRecordCommand}" Header="删除记录" />
            </MenuItem>
        </Menu>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold">
                <Run Text="当前余额：" />
                <Run Foreground="Green" Text="¥0.00" />
            </TextBlock>
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding MoneyInfos}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                        Header="日期" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Category, Converter={StaticResource CategoryToStringConverter}}"
                        Header="类别" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Amount}"
                        Header="金额" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Note}"
                        Header="备注" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
