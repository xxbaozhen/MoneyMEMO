<Window
    x:Class="MoneyMEMO.Views.Update"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:MoneyMEMO.Converters"
    xmlns:behaviors="clr-namespace:MoneyMEMO.Behaviors"
    xmlns:models="clr-namespace:MoneyMEMO.Models"
    xmlns:vm="clr-namespace:MoneyMEMO.ViewModels"
    Title="修改记录"
    Width="400"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:UpdateViewModel />
    </Window.DataContext>


    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  日期  -->
        <StackPanel Margin="0,5" Orientation="Horizontal">
            <TextBlock
                Width="80"
                VerticalAlignment="Center"
                Text="日期：" />

            <!--  单日期输入  -->
            <DatePicker Width="120" SelectedDate="{Binding Date}" />
        </StackPanel>

        <!--  金额  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,5"
            Orientation="Horizontal">
            <TextBlock
                Width="80"
                VerticalAlignment="Center"
                Text="金额：" />

            <!--  单金额  -->
            <TextBox
                Width="120"
                behaviors:DecimalInputBehavior.DecimalPlaces="2"
                behaviors:DecimalInputBehavior.IsEnabled="True"
                Text="{Binding AmountText}" />
        </StackPanel>

        <!--  类别  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,5"
            Orientation="Horizontal">
            <TextBlock
                Width="80"
                VerticalAlignment="Center"
                Text="类别：" />
            <RadioButton
                Margin="0,0,20,0"
                Content="收入"
                GroupName="Category"
                IsChecked="{Binding IsIncome, Mode=TwoWay}" />

            <RadioButton
                Margin="0,0,20,0"
                Content="支出"
                GroupName="Category"
                IsChecked="{Binding IsExpense, Mode=TwoWay}" />

        </StackPanel>

        <!--  备注  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,5"
            Orientation="Horizontal">
            <TextBlock
                Width="80"
                VerticalAlignment="Center"
                Text="备注：" />
            <TextBox Width="220" Text="{Binding NoteKeyword}" />
        </StackPanel>

        <!--  按钮  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="25"
                Margin="0,0,10,0"
                Command="{Binding ConfirmCommand}"
                Content="修改" />
            <Button
                Width="100"
                Height="25"
                Command="{Binding CancelCommand}"
                Content="取消" />
        </StackPanel>

    </Grid>
</Window>
